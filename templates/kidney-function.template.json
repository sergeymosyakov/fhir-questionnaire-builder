              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif((%resource.item.where(linkId='kidney').item.where(linkId='kidney-creatinine').answer.valueDecimal) > 0 and (%resource.item.where(linkId='kidney').item.where(linkId='kidney-age').answer.valueInteger).exists() and (%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code).exists(), (142 * iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-creatinine').answer.valueDecimal) / iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code) = 'LA3-6'), 0.7, 0.9)) < 1, ((%resource.item.where(linkId='kidney').item.where(linkId='kidney-creatinine').answer.valueDecimal) / iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code) = 'LA3-6'), 0.7, 0.9)), 1).power(iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code) = 'LA3-6'), -0.241, -0.302)) * iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-creatinine').answer.valueDecimal) / iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code) = 'LA3-6'), 0.7, 0.9)) > 1, ((%resource.item.where(linkId='kidney').item.where(linkId='kidney-creatinine').answer.valueDecimal) / iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code) = 'LA3-6'), 0.7, 0.9)), 1).power(-1.2) * 0.9938.power((%resource.item.where(linkId='kidney').item.where(linkId='kidney-age').answer.valueInteger)) * iif(((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code) = 'LA3-6'), 1.012, 1)).round(0), {})"
              }
            }
          ]
        },
        {
