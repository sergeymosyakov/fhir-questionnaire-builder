              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code).exists(), ((((140 - (%resource.item.where(linkId='kidney').item.where(linkId='kidney-age').answer.valueInteger)) * (%resource.item.where(linkId='kidney').item.where(linkId='kidney-weight').answer.valueDecimal)) / (72 * (%resource.item.where(linkId='kidney').item.where(linkId='kidney-creatinine').answer.valueDecimal))) * iif((%resource.item.where(linkId='kidney').item.where(linkId='kidney-sex').answer.valueCoding.code) = 'LA3-6', 0.85, 1)).round(0), {}).where($this >= 0)"
              }
