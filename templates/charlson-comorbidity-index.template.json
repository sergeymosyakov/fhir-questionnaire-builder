              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%resource.item.where(linkId='cci').item.where(linkId='cci-age').answer.valueInteger.exists(), (((iif(%resource.item.where(linkId='cci').item.where(linkId='cci-mi').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-chf').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-pvd').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-cvd').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-dementia').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-copd').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-rheum').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-ulcer').answer.valueBoolean, 1, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-hemiplegia').answer.valueBoolean, 2, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-renal').answer.valueBoolean, 2, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-leukemia').answer.valueBoolean, 2, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-lymphoma').answer.valueBoolean, 2, 0)) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-aids').answer.valueBoolean, 6, 0)) + (iif((%resource.item.where(linkId='cci').item.where(linkId='cci-liver').answer.valueCoding.code = 'mild'), 1, 0)) + (iif((%resource.item.where(linkId='cci').item.where(linkId='cci-liver').answer.valueCoding.code = 'severe'), 3, 0)) + (iif((%resource.item.where(linkId='cci').item.where(linkId='cci-diabetes').answer.valueCoding.code = 'uncomplicated'), 1, 0)) + (iif((%resource.item.where(linkId='cci').item.where(linkId='cci-diabetes').answer.valueCoding.code = 'end-organ'), 2, 0)) + (iif((%resource.item.where(linkId='cci').item.where(linkId='cci-tumor').answer.valueCoding.code = 'localized'), 2, 0)) + (iif((%resource.item.where(linkId='cci').item.where(linkId='cci-tumor').answer.valueCoding.code = 'metastatic'), 6, 0))) + (iif(%resource.item.where(linkId='cci').item.where(linkId='cci-age').answer.valueInteger.exists(), iif(%resource.item.where(linkId='cci').item.where(linkId='cci-age').answer.valueInteger < 50, 0, iif(%resource.item.where(linkId='cci').item.where(linkId='cci-age').answer.valueInteger < 60, 1, iif(%resource.item.where(linkId='cci').item.where(linkId='cci-age').answer.valueInteger < 70, 2, iif(%resource.item.where(linkId='cci').item.where(linkId='cci-age').answer.valueInteger < 80, 3, 4)))), {}))), {})"
