          "readOnly": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%resource.repeat(item).where(linkId='gad7-total').answer.valueDecimal.exists(), iif(%resource.repeat(item).where(linkId='gad7-total').answer.valueDecimal < 5, 'Minimal anxiety', iif(%resource.repeat(item).where(linkId='gad7-total').answer.valueDecimal < 10, 'Mild anxiety', iif(%resource.repeat(item).where(linkId='gad7-total').answer.valueDecimal < 15, 'Moderate anxiety', 'Severe anxiety'))), {})"
              }
            }
          ]
