            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%resource.repeat(item).where(linkId in ('gad7-q1' | 'gad7-q2' | 'gad7-q3' | 'gad7-q4' | 'gad7-q5' | 'gad7-q6' | 'gad7-q7')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.count() = 7, %resource.repeat(item).where(linkId in ('gad7-q1' | 'gad7-q2' | 'gad7-q3' | 'gad7-q4' | 'gad7-q5' | 'gad7-q6' | 'gad7-q7')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.sum(), {})"
