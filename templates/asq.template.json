  "item": [
    {
      "linkId": "asq",
      "text": "ASQ Suicide Risk Screening",
      "type": "group",
      "item": [
        {
          "linkId": "asq-intro",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "115565-4"
            }
          ],
          "type": "display",
          "text": "Ask the patient:"
        },
        {
          "linkId": "asq-q1",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "115566-2"
            }
          ],
          "text": "In the past few weeks, have you wished you were dead?",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            }
          ],
          "required": true,
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://loinc.org",
                "code": "LA33-6",
                "display": "Yes"
              }
            },
            {
              "valueCoding": {
                "system": "http://loinc.org",
                "code": "LA32-8",
                "display": "No"
              }
            }
          ]
        },
        {
          "linkId": "asq-q2",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "115567-0"
            }
          ],
          "text": "In the past few weeks, have you felt that you or your family would be better off if you were dead?",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            }
          ],
          "required": true,
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://loinc.org",
                "code": "LA33-6",
                "display": "Yes"
              }
            },
            {
              "valueCoding": {
                "system": "http://loinc.org",
                "code": "LA32-8",
                "display": "No"
              }
            }
          ]
        },
        {
          "linkId": "asq-q3",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "115568-8"
            }
          ],
          "text": "In the past week, have you been having thoughts about killing yourself?",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            }
          ],
          "required": true,
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://loinc.org",
                "code": "LA33-6",
                "display": "Yes"
              }
            },
            {
              "valueCoding": {
                "system": "http://loinc.org",
                "code": "LA32-8",
                "display": "No"
              }
            }
          ]
        },
        {
          "linkId": "asq-q4",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "115569-6"
            }
          ],
          "text": "Have you ever tried to kill yourself?",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
