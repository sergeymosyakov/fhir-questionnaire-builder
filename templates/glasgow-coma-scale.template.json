        },
        {
          "linkId": "gcs-total",
          "code": [
            {
              "system": "http://loinc.org",
              "code": "9269-2"
            }
          ],
          "text": "Glasgow Coma Scale total score (3–15)",
          "type": "decimal",
          "readOnly": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%resource.repeat(item).where(linkId in ('gcs-eye' | 'gcs-verbal' | 'gcs-motor')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.count() = 3, %resource.repeat(item).where(linkId in ('gcs-eye' | 'gcs-verbal' | 'gcs-motor')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.sum(), {})"
              }
            }
          ]
        },
        {
          "linkId": "gcs-severity",
          "text": "Severity",
          "type": "string",
          "readOnly": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%resource.repeat(item).where(linkId='gcs-total').answer.valueDecimal.exists(), iif(%resource.repeat(item).where(linkId='gcs-total').answer.valueDecimal < 9, 'Severe (GCS 3–8)', iif(%resource.repeat(item).where(linkId='gcs-total').answer.valueDecimal < 13, 'Moderate (GCS 9–12)', 'Mild (GCS 13–15)')), {})"
              }
            }
          ]
        }
      ]
