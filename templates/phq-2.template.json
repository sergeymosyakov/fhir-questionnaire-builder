                "expression": "iif(%resource.repeat(item).where(linkId in ('phq2-q1' | 'phq2-q2')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.count() = 2, %resource.repeat(item).where(linkId in ('phq2-q1' | 'phq2-q2')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.sum(), {})"
