                "expression": "iif(%resource.repeat(item).where(linkId='phq2-total').answer.valueDecimal.exists(), iif(%resource.repeat(item).where(linkId='phq2-total').answer.valueDecimal < 3, 'Negative screen', 'Positive screen — follow up with the PHQ-9'), {})"
