              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%resource.repeat(item).where(linkId in ('gds15-q1' | 'gds15-q2' | 'gds15-q3' | 'gds15-q4' | 'gds15-q5' | 'gds15-q6' | 'gds15-q7' | 'gds15-q8' | 'gds15-q9' | 'gds15-q10' | 'gds15-q11' | 'gds15-q12' | 'gds15-q13' | 'gds15-q14' | 'gds15-q15')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.count() = 15, %resource.repeat(item).where(linkId in ('gds15-q1' | 'gds15-q2' | 'gds15-q3' | 'gds15-q4' | 'gds15-q5' | 'gds15-q6' | 'gds15-q7' | 'gds15-q8' | 'gds15-q9' | 'gds15-q10' | 'gds15-q11' | 'gds15-q12' | 'gds15-q13' | 'gds15-q14' | 'gds15-q15')).answer.valueCoding.extension('http://hl7.org/fhir/StructureDefinition/ordinalValue').valueDecimal.sum(), {})"
